{
  "name": "ontoweave",
  "version": "0.2.0-alpha.2",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Temporal knowledge graphs and traceable memory for people and agents",
  "engines": {
    "node": ">=22.22.0 <23 || >=24.15.0 <25"
  },
  "scripts": {
    "build:web": "node scripts/build-graph.mjs",
    "start": ".venv-pg-cq/bin/python -B scripts/ontoweave-workbench.py start",
    "check": "node --check scripts/start-ontoweave.mjs && node --check web/ontoweave-pg-gateway.mjs && node --check web/unified-workbench-v2.mjs",
    "setup:runtime": "node scripts/setup-ontoweave-runtime.mjs",
    "test": "node --no-experimental-sqlite --test web/native-fact-reception-v5.test.mjs tests/workbench-assets.test.mjs",
    "setup:parser": "node scripts/setup-ontoweave-parser.mjs",
    "setup:workbench": ".venv-pg-cq/bin/python -B scripts/ontoweave-workbench.py setup"
  },
  "dependencies": {
    "@sigma/edge-curve": "3.1.0",
    "@sigma/node-border": "3.0.0",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "jsonc-parser": "3.3.1",
    "jsonrepair": "3.15.0",
    "marked": "18.2.0",
    "sigma": "3.0.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
