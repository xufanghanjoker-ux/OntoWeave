{
  "name": "ontoweave",
  "version": "0.1.0-alpha.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "description": "Temporal knowledge graphs and traceable memory for people and agents",
  "engines": {
    "node": ">=22.22.0 <23 || >=24.15.0 <25"
  },
  "scripts": {
    "build:web": "node scripts/build-graph.mjs",
    "start": "node scripts/start-ontoweave.mjs",
    "setup": "node web/manage.mjs setup",
    "doctor": "node web/manage.mjs doctor",
    "check": "node --check web/app.mjs && node --check web/server.mjs && node --check web/engine.mjs && node --check web/mcp-stdio.mjs",
    "setup:runtime": "node scripts/setup-ontoweave-runtime.mjs",
    "test": "node --test web/native-fact-reception-v5.test.mjs web/native-fact-reception-chain-v5.test.mjs"
  },
  "dependencies": {
    "@sigma/edge-curve": "3.1.0",
    "@sigma/node-border": "3.0.0",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "jsonc-parser": "3.3.1",
    "jsonrepair": "3.15.0",
    "marked": "18.2.0",
    "neo4j-driver": "6.2.0",
    "sigma": "3.0.3"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
