{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lightog:demand:0.2:learning",
  "description": "Additive lifecycle extension; local refs to demand0.1 defs are resolved offline by Learning contract kernel. Trusted fields are populated by the service, never by models.",
  "$defs": {
    "LearningJob": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "lightog-learning/0.2"
        },
        "intent": {
          "$ref": "#/$defs/LearningIntent"
        },
        "stage": {
          "enum": [
            "NOT_REQUESTED",
            "QUEUED",
            "RETRIEVING",
            "EXTRACTING",
            "VALIDATING",
            "COMMITTING",
            "COMPLETED",
            "WAIT_EVIDENCE",
            "WAIT_REVIEW",
            "DEFERRED",
            "SUPERSEDED",
            "STOPPED",
            "FAILED"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "dimension_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope": {
          "type": "object",
          "properties": {
            "checked_unit_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "uniqueItems": true,
              "maxItems": 10000
            },
            "unsearched_unit_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "uniqueItems": true,
              "maxItems": 10000
            }
          },
          "required": [
            "checked_unit_ids",
            "unsearched_unit_ids"
          ],
          "additionalProperties": false
        },
        "commit_receipt_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "contract_version",
        "intent",
        "stage",
        "revision",
        "dimension_sha256",
        "policy_version",
        "scope",
        "commit_receipt_ref"
      ],
      "additionalProperties": false
    },
    "LearningTransition": {
      "type": "object",
      "properties": {
        "previous": {
          "$ref": "#/$defs/LearningJob"
        },
        "next": {
          "$ref": "#/$defs/LearningJob"
        },
        "trusted_context": {
          "type": "object"
        },
        "trusted_runtime": {
          "$ref": "#/$defs/LearningRuntime"
        }
      },
      "required": [
        "previous",
        "next",
        "trusted_context",
        "trusted_runtime"
      ],
      "additionalProperties": false
    },
    "LearningRuntime": {
      "type": "object",
      "properties": {
        "current_snapshot": {
          "$ref": "#/$defs/SourceSnapshot"
        },
        "persisted_job_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "persisted_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scope_unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true,
          "maxItems": 10000
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "receipt_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "task_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "input_snapshot_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "dimension_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "output_graph_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "index_manifest_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "index_state": {
                "enum": [
                  "READY",
                  "PENDING"
                ]
              }
            },
            "required": [
              "receipt_ref",
              "task_ref",
              "input_snapshot_sha256",
              "dimension_sha256",
              "output_graph_revision",
              "index_manifest_ref",
              "index_state"
            ],
            "additionalProperties": false
          },
          "maxItems": 10000
        },
        "units": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "type": "object",
            "properties": {
              "unit_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "start": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "unit_id",
              "source_ref",
              "source_revision",
              "text_sha256",
              "start",
              "end"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "current_snapshot",
        "persisted_job_sha256",
        "persisted_revision",
        "scope_unit_ids",
        "commits",
        "units"
      ],
      "additionalProperties": false
    }
  }
}
